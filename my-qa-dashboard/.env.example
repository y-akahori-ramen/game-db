# Set VITE_USE_MOCK=false to use the real /api/search backend in production.
VITE_USE_MOCK=true

# Cognito Hosted UI (leave unset for local mock/dev mode)
VITE_COGNITO_DOMAIN=https://game-qa-dashboard.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
# Optional; defaults to `${window.location.origin}/callback`
VITE_COGNITO_REDIRECT_URI=
# Optional; defaults to `${window.location.origin}/`
VITE_COGNITO_LOGOUT_URI=
