# ==============================================================================
# Game QA Dashboard On-Premises Environment Configuration
# ==============================================================================

# Application Port exposed to the DMZ reverse proxy
HOST_PORT=8080

# Public URL configured in DMZ reverse proxy (used for Google OAuth callback)
APP_URL=https://qa-dashboard.internal.example.com

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (OIDC) Configuration
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console (Web application client):
# - Authorized redirect URIs: ${APP_URL}/oauth2/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Generate a 16, 24, or 32-byte secret (e.g., `openssl rand -base64 32 | tr -- '+/' '-_'`)
OAUTH2_PROXY_COOKIE_SECRET=your-random-cookie-secret-32-chars-base64

# Restrict login to your company's Google Workspace domain (e.g. example.com)
# Set to * to allow any Google account
GOOGLE_ALLOWED_DOMAINS=example.com

# ------------------------------------------------------------------------------
# Persistent Storage Mount Paths (Host paths for Bind Mount)
# ------------------------------------------------------------------------------
# By default, Docker named volumes (qa_data, qa_db) are used.
# For production on-premises deployments, uncomment and specify host absolute paths:
#
# Large artifact storage (raw test metrics, logs, capture videos, crash dumps).
# Can be mounted to host high-capacity HDD, RAID array, or mounted NAS directory (NFS/SMB).
# HOST_STORAGE_DATA_PATH=/mnt/storage/game-qa/runs
#
# SQLite WAL database storage directory (/data/db/qa.db).
# MUST be located on a fast local SSD (do NOT use network storage like NFS/SMB
# due to SQLite WAL shared-memory and file locking constraints).
# HOST_STORAGE_DB_PATH=/var/lib/game-qa/db

# ------------------------------------------------------------------------------
# Storage Quota & Retention Policy Configuration
# ------------------------------------------------------------------------------
# Minimum disk free space percentage required before rejecting uploads with HTTP 507
MIN_DISK_FREE_PERCENT=10.0

# Minimum disk free space in bytes (default: 1 GB)
MIN_DISK_FREE_BYTES=1073741824

# Retention period in days for purging large video / crash dump files (default: 30 days)
RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# Optional Outbound Proxy Configuration
# ------------------------------------------------------------------------------
# If the DMZ requires a forward proxy to reach Google:
# HTTPS_PROXY=http://proxy.internal.example.com:8080
# HTTP_PROXY=http://proxy.internal.example.com:8080

# Allow uploads without API key (only set to true for local testing!)
ALLOW_ANONYMOUS_UPLOAD=false

